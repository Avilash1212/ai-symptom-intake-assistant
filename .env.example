# Copy to .env and fill in. Never commit .env.

# Server
PORT=3001
NODE_ENV=development
# Long random string (min 32 chars). Generate e.g. with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Postgres connection string (Supabase). Leave empty for local development:
# an embedded database is then stored in server/data/pglite.
# On Vercel this is required - use Supabase's pooled connection string
# ("Transaction pooler", port 6543).
DATABASE_URL=

# Google Gemini (server-side only - never exposed to the browser).
# Get a free key at https://aistudio.google.com/apikey
# Leave empty to run with the built-in rule-based follow-ups and summaries.
# Note: on the free tier Google may use content to improve its products -
# use synthetic test data only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Doctor account created by `npm run seed` (synthetic demo account).
DOCTOR_NAME=Dr. Demo
DOCTOR_EMAIL=doctor@demo.clinic.test
DOCTOR_PASSWORD=Demo-Clinic-2026!
